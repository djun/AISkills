{
  "name": "odai-dsh-plugin",
  "version": "0.2.2",
  "description": "Profile-wide odai governance and routing bundle for DeepSeek Harness.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orziz/odai.git",
    "directory": "dsh/plugin"
  },
  "homepage": "https://github.com/orziz/odai#readme",
  "bugs": {
    "url": "https://github.com/orziz/odai/issues"
  },
  "type": "module",
  "main": "./runtime/index.mjs",
  "bin": {
    "odai-dsh-plugin": "./bin/odai-dsh-plugin.mjs"
  },
  "exports": {
    ".": "./runtime/index.mjs",
    "./router": "./runtime/router.mjs",
    "./governance": "./runtime/governance.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "bin",
    "runtime",
    "skills",
    "scripts/dsh-process.mjs",
    "scripts/live-routing-smoke-config.mjs",
    "scripts/live-routing-smoke.mjs",
    "scripts/live-compaction-cache-smoke.mjs",
    "scripts/verify-dsh-load.mjs",
    "scripts/verify-session-compat.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "find ../runtime/src ../runtime/tests bin scripts tests -name '*.mjs' -print0 | xargs -0 -n1 node --check",
    "prepare:artifact": "node ../../scripts/package-odai-artifact.mjs prepare --skill-root skills --runtime-root runtime",
    "clean:artifact": "node ../../scripts/package-odai-artifact.mjs clean --skill-root skills --runtime-root runtime",
    "prepare": "npm run prepare:artifact",
    "verify:version": "node ../../scripts/verify-dsh-package-versions.mjs",
    "prepack": "npm run verify:version && node ../../scripts/validate-odai-skill.mjs",
    "postpack": "npm run clean:artifact",
    "pack:dry-run": "node ../../scripts/run-package-pack.mjs --clean runtime --clean skills -- --dry-run",
    "test": "npm run verify:version && node --test ../runtime/tests/*.test.mjs ./tests/*.test.mjs",
    "verify:dsh": "node ./scripts/verify-session-compat.mjs && node ./scripts/verify-dsh-load.mjs",
    "smoke:live": "node ./scripts/live-routing-smoke.mjs",
    "smoke:compaction-cache": "node ./scripts/live-compaction-cache-smoke.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6 || 0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
