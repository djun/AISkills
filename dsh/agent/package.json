{
  "name": "odai-dsh-agent",
  "version": "0.0.6",
  "description": "完整继承 DSH 标准模式 全部能力的 Odai Agent preset。主要用于治理、规划、测试、验证 等，可当成默认总控使用。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orziz/odai.git",
    "directory": "dsh/agent"
  },
  "homepage": "https://github.com/orziz/odai#readme",
  "bugs": {
    "url": "https://github.com/orziz/odai/issues"
  },
  "type": "module",
  "main": "./src/installer.mjs",
  "exports": {
    ".": "./src/installer.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "odai-dsh-agent": "./bin/odai-dsh-agent.mjs"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "bin",
    "src",
    "scripts/verify-agent-load.mjs",
    "preset",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "find bin src scripts tests -name '*.mjs' -print0 | xargs -0 -n1 node --check",
    "prepare:artifact": "node ../../scripts/package-odai-artifact.mjs prepare --skill-root preset/odai/skills --runtime-root preset/odai/runtime",
    "clean:artifact": "node ../../scripts/package-odai-artifact.mjs clean --skill-root preset/odai/skills --runtime-root preset/odai/runtime",
    "prepare": "npm run prepare:artifact",
    "prepack": "node ../../scripts/validate-odai-skill.mjs",
    "postpack": "npm run clean:artifact",
    "pack:dry-run": "node ../../scripts/run-package-pack.mjs --clean preset/odai/runtime --clean preset/odai/skills -- --dry-run",
    "test": "node --test ./tests/*.test.mjs",
    "verify:dsh": "node ./scripts/verify-agent-load.mjs"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "keywords": [
    "agent",
    "deepseek-harness",
    "dsh",
    "odai",
    "preset"
  ]
}
